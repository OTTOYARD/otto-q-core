  "not_carried": [
    {
      "ottoq": "ottoq_telemetry_packets.dtc_codes",
      "why": "not OBD-II, so not VSS Vehicle.Diagnostics.DTCList, which VSS 6.0 defines as 'List of currently active DTCs formatted according OBD II (SAE-J2012DA_201812) standard ([P|C|B|U]XXXXX )' (spec/Vehicle/Diagnostics.vspec). Measured 2026-10-09 on the twin depot's vehicles, 30 days: 834,782 packets carry 710 codes in 15 distinct values, every one the twin's own form (AV-P0003, AV-PL010, AV-H0050 ...), none in J2012 form. They travel as vehicle.fault.summary fault_codes, stored as sent and never interpreted. A real operator's OBD-II codes may still use DTCList."
    },
    {
      "ottoq": "ottoq_telemetry_packets.vehicle_state (17 states)",
      "why": "a depot process state OTTO-Q derives; an operator does not send it"
    },
    {
      "ottoq": "ottoq_telemetry_packets.soc_source, data_source, fleet_operator_id, sim_run_id",
      "why": "come from the credential and the door, never the payload (README rule 1)"
    },
    {
      "ottoq": "ottoq_telemetry_packets.motor_temp_c (Vehicle.Powertrain.ElectricMotor.Temperature)",
      "why": "no depot decision reads it"
    },
    {
      "ottoq": "ottoq_telemetry_packets.cabin_temp_c (Vehicle.Cabin.HVAC.AmbientAirTemperature)",
      "why": "cabin conditioning is the operator's"
    },
    {
      "ottoq": "ottoq_telemetry_packets.heading_deg (Vehicle.CurrentLocation.Heading)",
      "why": "no depot decision reads it"
    },
    {
      "ottoq": "ottoq_telemetry_packets.power_15min_avg_kw",
      "why": "no VSS signal; derived by OTTO-Q from CurrentPower over time"
    },
    {
      "ottoq": "ottoq_telemetry_packets.active_warnings, signal_strength_pct, packet_integrity, dropped_reason",
      "why": "transport and diagnostics of the old door; the fault summary carries what a warning means"
    }
  ],
