{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ottoyard.com/schemas/ottoq/contract/0.1/readiness.forecast.json",
  "title": "com.ottoyard.readiness.forecast (OTTO-Q to operator)",
  "description": "When OTTO-Q expects the car to be ready for work, with its spread. Informational: no ack.",
  "type": "object",
  "required": ["vehicle_ref", "as_of", "ready_p50", "ready_p90", "open_services"],
  "properties": {
    "vehicle_ref": {"$ref": "defs.json#/$defs/vehicleRef"},
    "as_of": {"$ref": "defs.json#/$defs/timestamp"},
    "ready_p50": {"$ref": "defs.json#/$defs/timestamp"},
    "ready_p90": {"$ref": "defs.json#/$defs/timestamp"},
    "soc_at_ready_pct": {"$ref": "defs.json#/$defs/percent"},
    "open_services": {
      "type": "array",
      "items": {"$ref": "defs.json#/$defs/serviceCode"},
      "uniqueItems": true,
      "maxItems": 32
    }
  },
  "additionalProperties": false
}
