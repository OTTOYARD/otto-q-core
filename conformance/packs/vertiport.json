  "constraints": [
    {
      "code": "V1_Vertipad_Exclusive_Use",
      "description": "One vertipad per aircraft during landing and takeoff.",
      "mechanism": "exclusive_occupancy"
    },
    {
      "code": "V2_Tug_As_Resource",
      "description": "Only N tugs; repositioning queues behind them.",
      "mechanism": "movement_as_operation",
      "note": "2.3 already requires inter-point moves to consume path resources. A tug is that resource, named."
    },
    {
      "code": "V3_Charger_Compatibility",
      "description": "CCS or proprietary connector (AS6968 draft); the handshake means duration is not determined by power alone.",
      "mechanism": "capability_pair",
      "note": "PARTIAL, AND THE PACK SAYS SO. capability_pair expresses WHICH aircraft may use which stand. It does NOT express a duration that varies with a non-numeric handshake. The compatibility half conforms; the duration half is untested."
    },
    {
      "code": "V4_Battery_Cooling",
      "description": "20-minute cooldown before fast charge if SoC > 90% on landing. Physical state gates scheduling.",
      "mechanism": "layer1_rule",
      "note": "RECLASSIFIED 2026-08-22. Originally recorded as a finding with no mechanism, on the reasoning that min_gap_on_point is a property of the POINT while this gap belongs to the ASSET and is conditional on SoC. That reasoning was right about min_gap_on_point and wrong about the kernel: Layer 1 (ottoq_rules) is exactly a conditional, parameterizable, logged precondition engine \u2014 HW.002.charger_state_precondition is the same shape already in production. A 'block fast_charge for 20 min after landing when SoC > 90' rule is a row, not a code change. The omission was in the registry, not the engine."
    },
    {
      "code": "V5_Pad_Separation",
      "description": "Minimum 1.5x aircraft diameter between active vertipads (FAA EB 105A).",
      "mechanism": null,
      "finding_class": "SOLVER_CHANGE",
      "note": "A GEOMETRIC constraint coupling two points' simultaneous occupancy. Every kernel resource mechanism is per-point (exclusive_occupancy) or site-wide (site_power_cap). Nothing expresses 'these two points may not both be active', which is a pairwise spatial exclusion. This is the clearest candidate in the whole pack set for a genuine solver change."
    }
  ],
  "path_resources": [
    {
      "code": "tug",
      "capacity": 2,
      "description": "Ground tugs (H3 'Tug-As-Resource'). Only N available; repositioning queues behind them."
    }
  ]
