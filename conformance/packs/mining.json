  "constraints": [
    {
      "code": "C1_Asset_Must_Have_Clearance",
      "description": "A machine must be empty of payload and powered down before entering a service bay.",
      "mechanism": "movement_as_operation",
      "note": "Modelled as a mandatory predecessor operation (payload_clearance) on its own point \u2014 an ordered prerequisite, which the flow-shop model already expresses."
    },
    {
      "code": "C2_Resource_Sharing_Exclusive_Use",
      "description": "A service bay is non-sharable for the operation's duration.",
      "mechanism": "exclusive_occupancy"
    },
    {
      "code": "C3_Energy_Resupply_Window",
      "description": "SoC/fuel must be above a floor to begin return-to-base and below a ceiling to receive service.",
      "mechanism": "threshold_ladder"
    },
    {
      "code": "C4_Dynamic_Charging_Path_Dependency",
      "description": "A trolley-assisted truck MUST follow a fixed physical line; its route is a hard infrastructure constraint, not an optimal path.",
      "mechanism": "movement_as_operation",
      "note": "Expressed by modelling the trolley segment as a service point with exclusive occupancy and 'recharge' capability, so route-as-constraint becomes point-as-resource. H2 predicted this needs an infrastructure network model; the pack asserts the weaker claim is sufficient. THE HARNESS TESTS IT, this note does not settle it."
    },
    {
      "code": "C5_Maintenance_Scheduling_From_Threshold_Ranges",
      "description": "Recall triggers when ANY of component hours, oil analysis, or TPMS crosses a threshold.",
      "mechanism": "threshold_ladder",
      "note": "RecallDecision is literally a first-hit-wins rung ladder over multi-signal AssetState. H2 rated this a kernel-breaker; the pack claims it is already supported."
    },
    {
      "code": "C6_Operator_Override_Overrules_System",
      "description": "A human can override a scheduled service event and keep the truck on the hauling cycle. H2: 'anathema to a solver-based kernel'.",
      "mechanism": "work_side_refusal",
      "note": "CLAIMED, NOT PROVEN. 2.7 makes work-side refusal a first-class event triggering re-solve. If an override is a refusal with a human actor, this holds. If it must also INVALIDATE a constraint the solver treated as hard, work_side_refusal does not cover it and this becomes SOLVER_CHANGE. See CONFORMANCE_FINDINGS.md."
    }
  ]
}